  <vhdl appearance="logisim_evolution" name="rs_latch">library ieee;
use ieee.std_logic_1164.all;

entity rs_latch is
    port (
        r, s : in  std_logic;
        q    : out std_logic;
        qn   : out std_logic
    );
end entity rs_latch;

architecture bhv of rs_latch is
    signal q_i  : std_logic := '0';
    signal qn_i : std_logic := '1';
begin
    process(s, r)
    begin
        if s = '1' and r = '1' then      -- forbidden: both outputs 0
            q_i &lt;= '0'; qn_i &lt;= '0';
        elsif s = '1' then               -- set
            q_i &lt;= '1'; qn_i &lt;= '0';
        elsif r = '1' then               -- reset
            q_i &lt;= '0'; qn_i &lt;= '1';
        end if;                          -- s=0, r=0: hold
    end process;
    q  &lt;= q_i;
    qn &lt;= qn_i;
end architecture bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="d_latch">library ieee;
use ieee.std_logic_1164.all;

entity d_latch is
    port (
        en : in  std_logic;
        d  : in  std_logic;
        q  : out std_logic;
        qn : out std_logic
    );
end entity d_latch;

architecture bhv of d_latch is
    signal q_i : std_logic := '0';
begin
    process(en, d)
    begin
        if en = '1' then
            q_i &lt;= d;
        end if;                          -- en=0: hold
    end process;
    q  &lt;= q_i;
    qn &lt;= not q_i;
end architecture bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="d_ff">library ieee;
use ieee.std_logic_1164.all;

entity d_ff is
    port (
        clk : in  std_logic;
        d   : in  std_logic;
        q   : out std_logic
    );
end entity d_ff;

architecture bhv of d_ff is
    signal q_i : std_logic := '0';
begin
    process(clk)
    begin
        if rising_edge(clk) then
            q_i &lt;= d;
        end if;
    end process;
    q &lt;= q_i;
end architecture bhv;</vhdl>
</project>
