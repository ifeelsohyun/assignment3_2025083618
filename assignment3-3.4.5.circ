  <vhdl appearance="logisim_evolution" name="d_ff">library ieee;
use ieee.std_logic_1164.all;

entity d_ff is
    port (
        clk : in  std_logic;
        d   : in  std_logic;
        q   : out std_logic
    );
end entity d_ff;

architecture bhv of d_ff is
    signal q_i : std_logic := '0';
begin
    process(clk)
    begin
        if rising_edge(clk) then
            q_i &lt;= d;
        end if;
    end process;
    q &lt;= q_i;
end architecture bhv;
</vhdl>
  <vhdl appearance="logisim_evolution" name="jk_ff">library ieee;
use ieee.std_logic_1164.all;

entity jk_ff is
    port (
        clk : in  std_logic;
        j   : in  std_logic;
        k   : in  std_logic;
        q   : out std_logic
    );
end entity jk_ff;

architecture bhv of jk_ff is
    signal q_i : std_logic := '0';
begin
    process(clk)
    begin
        if rising_edge(clk) then
            if    j = '0' and k = '0' then q_i &lt;= q_i;      -- hold
            elsif j = '0' and k = '1' then q_i &lt;= '0';      -- reset
            elsif j = '1' and k = '0' then q_i &lt;= '1';      -- set
            else                           q_i &lt;= not q_i;  -- toggle
            end if;
        end if;
    end process;
    q &lt;= q_i;
end architecture bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="d_ff_sc">library ieee;
use ieee.std_logic_1164.all;

entity d_ff_sc is
    port (
        clk : in  std_logic;
        d   : in  std_logic;
        clr : in  std_logic;   -- asynchronous clear (highest priority)
        set : in  std_logic;   -- asynchronous set
        q   : out std_logic
    );
end entity d_ff_sc;

architecture bhv of d_ff_sc is
begin
    process(clk, clr, set)
    begin
        if clr = '1' then
            q &lt;= '0';
        elsif set = '1' then
            q &lt;= '1';
        elsif rising_edge(clk) then
            q &lt;= d;
        end if;
    end process;
end architecture bhv;</vhdl>
